POSTGRES_DB=koloni
# Propriétaire des tables : crée le schéma et charge les données, l'application ne l'utilise pas
POSTGRES_USER=koloni_proprietaire
POSTGRES_PASSWORD=changeme
# Mot de passe du rôle koloni_app, utilisé par l'application (même valeur que NUXT_DATABASE_PASSWORD)
KOLONI_APP_PASSWORD=changeme
POSTGRES_PORT=5432
